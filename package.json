{
  "name": "chips-opencode",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode as a Chips harness, on its V2 server (opencode serve): each OpenCode agent a Chips agent, each room an OpenCode session.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "keep": "tsx src/main.ts --keep",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "node --import tsx --test test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chipschat/harness": "file:vendor/chipschat-harness-0.0.0.tgz",
    "@chipschat/protocol": "file:vendor/chipschat-protocol-0.0.0.tgz",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@chipschat/conformance": "file:vendor/chipschat-conformance-0.0.0.tgz",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
